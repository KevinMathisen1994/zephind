# Copy to .env and fill in. Never commit the filled-in file.

# --- Database ---------------------------------------------------------------
# Supabase project URL and SERVICE ROLE key. The service role bypasses RLS, so
# it must never reach the browser — backend process only.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth -------------------------------------------------------------------
# Clerk's Frontend API URL (Clerk dashboard -> API keys). Without it every
# request fails closed as unauthenticated.
CLERK_FRONTEND_API_URL=https://<your>.clerk.accounts.dev
# Leave EMPTY to accept Clerk's default session token (what the app sends).
# Set it only if you switch to a named JWT template, to match that template's
# `aud` claim.
CLERK_JWT_AUDIENCE=
# Optional, comma-separated: the origins allowed in the token's `azp` claim,
# e.g. https://zephind.netlify.app. Unset means no check.
CLERK_ALLOWED_ORIGINS=

# --- This service's public origin -------------------------------------------
# Where providers redirect the browser back to after OAuth consent. Must match
# the redirect URI registered with Google/Microsoft.
PUBLIC_BACKEND_URL=http://localhost:3001

# --- Machine-to-machine ingest ----------------------------------------------
# Shared secret for /api/ingest, used by the scheduled scraper. This is the only
# thing between the open internet and those writes; rotating it means updating
# both this value and the GitHub Actions secret.
SCRAPER_INGEST_SECRET=
# Where scraper-service/src/cli.ts posts results from a GitHub Actions runner.
# Same value as the Actions secret BACKEND_URL.
BACKEND_URL=http://localhost:3001

# --- On-demand scraping (GitHub Actions dispatch) ---------------------------
GITHUB_REPO=<owner>/<repo>
GITHUB_DISPATCH_TOKEN=

# --- External APIs ----------------------------------------------------------
RAX_API_KEY=
# Reads マイソク PDFs natively, which is the only way to get data out of a
# 販売図面 whose price/address table is drawn rather than text (pdf-parse
# recovers only the room labels). Optional: without it, PDF-carrying mail falls
# back to Groq on pdf-parse's text output.
GEMINI_API_KEY=
# Optional override; see the default in src/services/mailIngest.ts.
GEMINI_MODEL=
GROQ_API_KEY=
# Must be a SERVER key: no HTTP-referrer restriction, or Google answers
# REQUEST_DENIED ("API keys with referer restrictions cannot be used with this
# API"). This is NOT the same key as the frontend's VITE_NEXT_PUBLIC_GOOGLE_
# MAPS_API_KEY. Needs Geocoding API + Places API (the legacy one — the code
# calls maps/api/place/nearbysearch, not places.googleapis.com).
GOOGLE_PLACES_API_KEY=
REINFOLIB_API_KEY=

# --- Mailbox connection (read-only) -----------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Set to false on replicas that should not run the 15-minute mail sync — two
# instances polling the same mailbox doubles every LLM call.
MAIL_SYNC_ENABLED=true

# --- 掲載日 (posted-date) detail-page budget --------------------------------
# See src/cli.ts for what each caps.
SCRAPE_POSTED_DATES=1
SCRAPE_POSTED_DATE_LIMIT=30
SCRAPE_POSTED_DATE_RUN_LIMIT=400
