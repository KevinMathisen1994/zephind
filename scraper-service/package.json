{
  "name": "scraper-service",
  "version": "1.0.0",
  "description": "Property scraper service for Zephind",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node fix-yargs.js",
    "dev": "tsx watch src/index.ts",
    "postinstall": "node fix-yargs.js",
    "build": "tsc",
    "build:edge": "esbuild src/edge.ts --bundle --platform=node --format=esm --target=es2022 --packages=external --banner:js=\"import { Buffer } from 'node:buffer'; import process from 'node:process';\" --outfile=../supabase/functions/api/bundle.js",
    "deploy:edge": "npm run build:edge && cd .. && supabase functions deploy api --no-verify-jwt --use-api --project-ref pfmyoftogbwvcdfpdxvz",
    "start": "node dist/index.js",
    "scrape": "tsx src/index.ts",
    "scrape:cron": "tsx src/cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jose": "^6.2.12",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0"
  }
}
